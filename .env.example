APP_NAME=PaingThu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: any other hostname the site answers on, comma separated, bare names only (no https://, port or wildcard). APP_URL must be
# the real public address: its host is always accepted, and if it is missing or malformed every request gets a 400 (fail closed).
# Use TRUSTED_HOSTS for the www name and for the name a health check or load balancer uses to call /up.
# TRUSTED_HOSTS=www.example.com
APP_DISPLAY_TIMEZONE=Asia/Bangkok

INERTIA_SSR_ENABLED=false

# The Content Security Policy is sent as Report-Only (the browser logs violations in its console and blocks nothing). Set this to true
# to enforce it once the console is clean.
# CSP_ENFORCE=false

APP_LOCALE=my
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Thai_Visa_Services
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# local for development; s3 for DigitalOcean Spaces in production
STORAGE_DRIVER=local
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_PRIVATE_BUCKET=
DO_SPACES_PUBLIC_BUCKET=
# The public address of the website images. Leave it commented out locally (it then defaults to APP_URL/storage, which needs
# `php artisan storage:link`); in production set it to the public Spaces bucket's address.
# PUBLIC_ASSETS_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
