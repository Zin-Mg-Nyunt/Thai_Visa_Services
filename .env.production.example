# PRODUCTION environment template. Laravel does not load this file; it reads only `.env`.
# Every <PLACEHOLDER> must be replaced on the Droplet. Never commit the real `.env`.
#
# First deployment, on the Droplet:
#   cp .env.production.example .env
#   (fill in every <PLACEHOLDER>)
#   php artisan key:generate
#   chmod 600 .env
# Later deployments: keep the existing `.env`; never overwrite it with this template.
# After editing `.env`, run `php artisan config:cache` again.

# --- Application ---
APP_NAME=PaingThu
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# A wrong APP_URL makes every request return 400: only its host (plus TRUSTED_HOSTS) is answered.
APP_URL=https://<YOUR_PRODUCTION_DOMAIN>
# Extra bare host names (no scheme or port), comma separated: the www name, a health-check host. Empty if none.
TRUSTED_HOSTS=<WWW_OR_HEALTH_CHECK_HOST_OR_EMPTY>
APP_LOCALE=my
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=Asia/Bangkok
APP_MAINTENANCE_DRIVER=file
VITE_APP_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=false
BCRYPT_ROUNDS=12

# --- Database (MySQL 8, on this Droplet; not a managed or remote database) ---
# Use a Production-only database and a user that can reach only that database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<PRODUCTION_DB_NAME>
DB_USERNAME=<PRODUCTION_DB_USER>
DB_PASSWORD=<PRODUCTION_DB_PASSWORD>
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- DigitalOcean Spaces (SGP1) ---
# Must be s3. If this line is missing or says `local`, documents and photos are written to the Droplet's disk without an error.
STORAGE_DRIVER=s3
DO_SPACES_REGION=sgp1
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com

# Private bucket (client documents and photos): keep it private, no public file listing.
DO_SPACES_PRIVATE_BUCKET=<PRODUCTION_PRIVATE_BUCKET_NAME>
DO_SPACES_PRIVATE_KEY=<PRODUCTION_PRIVATE_BUCKET_ACCESS_KEY>
DO_SPACES_PRIVATE_SECRET=<PRODUCTION_PRIVATE_BUCKET_SECRET>

# Public bucket (website images): no anonymous file listing. Use a separate read/write/delete key pair per bucket.
DO_SPACES_PUBLIC_BUCKET=<PRODUCTION_PUBLIC_BUCKET_NAME>
DO_SPACES_PUBLIC_KEY=<PRODUCTION_PUBLIC_BUCKET_ACCESS_KEY>
DO_SPACES_PUBLIC_SECRET=<PRODUCTION_PUBLIC_BUCKET_SECRET>

# Address browsers use for the public images (bucket address or a CDN/custom domain), no trailing slash.
PUBLIC_ASSETS_URL=https://<PUBLIC_ASSETS_HOST>

# --- Google sign-in ---
GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<PRODUCTION_GOOGLE_CLIENT_SECRET>
# Register this exact address under "Authorised redirect URIs" in Google Cloud Console once the domain is chosen.
GOOGLE_REDIRECT_URI=https://<YOUR_PRODUCTION_DOMAIN>/admin/auth/google/callback

# --- Sessions, cache, queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Needs HTTPS to be working: over plain http the browser drops the cookie and nobody can sign in.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Security ---
# The Content Security Policy is report-only. Check the browser console on the real site before setting this to true.
CSP_ENFORCE=false
# Trusted proxies are fixed in the code (127.0.0.1, ::1), which suits Nginx + PHP-FPM on the same Droplet.
